---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

import WhatsAppButton from '../components/WhatsAppButton.astro';
import { organization, website } from '../lib/schema';
interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string | null;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  schema?: unknown[];
}

const { title, description, path, ogImage, ogType, noindex, schema } = Astro.props;

/* Organization and WebSite are emitted here rather than per page so the
   `#organization` / `#website` nodes that Product, BlogPosting and
   CollectionPage reference by @id actually resolve on every route. Pages pass
   only their own page-specific graphs. */
const graphs = [organization(), website(), ...(schema ?? [])];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      schema={graphs}
    />
    {/* Favicons rendered down from the 512px master; the master itself was
        being fetched at High priority and cost 40KB ahead of the hero. */}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2026/01/Favicon.png" />
    <meta name="theme-color" content="#ECAE85" />
    <link
      rel="preload"
      href="/fonts/nunito-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    {/* ZeeOps live chat, deferred to the first interaction (or 6s after load)
        so its 23KB and its site-config request never compete with the page's
        own LCP. See public/chat-loader.js. Conversations land in the dashboard
        at chat.zeeops.dev under the `cardboardcups` site. */}
    <script src="/chat-loader.js" defer></script>
      <WhatsAppButton />
  </body>
</html>

---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

import WhatsAppButton from '../components/WhatsAppButton.astro';
import { organization, website } from '../lib/schema';
interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string | null;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  schema?: unknown[];
}

const { title, description, path, ogImage, ogType, noindex, schema } = Astro.props;

/* Organization and WebSite are emitted here rather than per page so the
   `#organization` / `#website` nodes that Product, BlogPosting and
   CollectionPage reference by @id actually resolve on every route. Pages pass
   only their own page-specific graphs. */
const graphs = [organization(), website(), ...(schema ?? [])];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      schema={graphs}
    />
    {/* Favicons rendered down from the 512px master; the master itself was
        being fetched at High priority and cost 40KB ahead of the hero. */}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2026/01/Favicon.png" />
    <meta name="theme-color" content="#ECAE85" />
    <link
      rel="preload"
      href="/fonts/nunito-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    {/* ZeeOps live chat. The widget and its site-config request used to run on
        every page load; they now wait for the visitor's first interaction, or
        6s after load for visitors who never interact, so they never compete
        with the page's own LCP. Bundled rather than inline so the strict CSP
        (script-src 'self' + chat.zeeops.dev) still covers it. Conversations
        land in the dashboard at chat.zeeops.dev under the `cardboardcups` site. */}
    <script>
      const events = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
      let loaded = false;
      const load = () => {
        if (loaded) return;
        loaded = true;
        for (const ev of events) window.removeEventListener(ev, load);
        const s = document.createElement('script');
        s.src = 'https://chat.zeeops.dev/widget.js?siteId=cardboardcups';
        s.async = true;
        document.body.appendChild(s);
      };
      for (const ev of events) window.addEventListener(ev, load, { passive: true, once: true });
      addEventListener('load', () => setTimeout(load, 6000));
    </script>
      <WhatsAppButton />
  </body>
</html>

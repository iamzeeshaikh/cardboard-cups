---
import Base from '../../layouts/Base.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaSection from '../../components/CtaSection.astro';
import products from '../../data/products.json';
import categories from '../../data/categories.json';
import imageManifest from '../../data/images.json';
import { CTA, PRICE_FROM } from '../../data/site';
import { breadcrumbs, faqPage, product as productSchema } from '../../lib/schema';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const bySlug = new Map(products.map((p) => [p.slug, p]));
const category = categories.find((c) => c.slug === product.category);
const related = product.related.map((s) => bySlug.get(s)!).filter(Boolean);

const crumbs = [
  { label: 'Home', href: '/' },
  ...(category ? [{ label: category.name, href: category.url }] : []),
  { label: product.name },
];

// One Product graph only — the WordPress build emitted two, with conflicting
// invented ratings. Description is the visible short description.
const schema = [
  productSchema({
    name: product.name,
    url: product.url,
    sku: product.sku,
    brand: product.brand,
    description: product.shortDescription[0] ?? product.seo.description ?? '',
    images: product.images,
    inStock: product.inStock,
  }),
  breadcrumbs(crumbs),
  faqPage(product.faqs),
];

// Gallery images resolved against the rendition manifest so the main image and
// its swap targets all carry intrinsic width/height and a WebP srcset.
const manifest = imageManifest as Record<
  string,
  { width: number; height: number; srcset: { url: string; w: number }[] }
>;
const heroSizes = '(max-width: 900px) 92vw, 440px';
const gallery = product.images.map((img, i) => {
  const info = manifest[img.src];
  const srcset = info?.srcset?.map((s) => `${s.url} ${s.w}w`).join(', ') ?? '';
  // Smallest rendition for the thumbnail strip; original as the fallback.
  const thumbRendition = info?.srcset?.[0];
  const thumb = thumbRendition?.url ?? img.src;
  const thumbW = thumbRendition?.w ?? info?.width;
  const thumbH =
    thumbRendition && info ? Math.round((thumbRendition.w * info.height) / info.width) : info?.height;
  return {
    src: img.src,
    srcset,
    alt: img.alt || `${product.name} image ${i + 1}`,
    width: info?.width,
    height: info?.height,
    thumb,
    thumbW,
    thumbH,
  };
});
const hero = gallery[0];
const specs = product.specifications;
---

<Base
  title={product.seo.title ?? `${product.name} | Cardboard Cups`}
  description={product.seo.description ?? product.shortDescription[0] ?? ''}
  path={product.url}
  ogImage={product.seo.ogImage}
  ogType="product"
  schema={schema}
>
  <Breadcrumbs items={crumbs} />

  <div class="container product">
    <div class="product__gallery">
      {
        hero && (
          <img
            id="main-img"
            class="product__hero"
            src={hero.src}
            srcset={hero.srcset || undefined}
            sizes={hero.srcset ? heroSizes : undefined}
            alt={hero.alt}
            width={hero.width}
            height={hero.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        )
      }
      {
        gallery.length > 1 && (
          <ul class="product__thumbs">
            {gallery.map((img, i) => (
              <li>
                <button
                  type="button"
                  class:list={['thumb-btn', { active: i === 0 }]}
                  data-src={img.src}
                  data-srcset={img.srcset || undefined}
                  data-sizes={img.srcset ? heroSizes : undefined}
                  data-alt={img.alt}
                  aria-label={`View image ${i + 1}: ${img.alt}`}
                >
                  <img
                    src={img.thumb}
                    alt={img.alt}
                    width={img.thumbW}
                    height={img.thumbH}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="product__summary">
      <h1>{product.name}</h1>
      {product.shortDescription.map((p) => <p>{p}</p>)}

      <p class="product__price">
        <span class="product__price-label">{PRICE_FROM.label}</span>
        <span class="product__price-amount">{PRICE_FROM.amount}</span>
      </p>

      <p class="product__stock">
        {product.inStock ? 'Available in Stock' : 'Made to order'}
      </p>

      {/* No checkout exists on this site, so the buying control is a quote request. */}
      <div class="product__actions">
        <a class="btn btn--primary" href={`${CTA.quote.href}?product=${encodeURIComponent(product.name)}`}>
          Get Free Quote
        </a>
        <a class="btn btn--outline" href="/contact-us/">Request Bulk Pricing</a>
      </div>

      <dl class="product__meta">
        <div><dt>SKU</dt><dd>{product.sku}</dd></div>
        {category && (
          <div><dt>Category</dt><dd><a href={category.url}>{category.name}</a></dd></div>
        )}
        <div><dt>Brand</dt><dd>{product.brand}</dd></div>
      </dl>
    </div>

    <aside class="product__aside">
      <QuoteForm id="product" product={product.name} />
    </aside>
  </div>

  <div class="container">
    <div class="tabs" data-tabs>
      <div class="tabs__list" role="tablist" aria-label="Product information">
        <button id="tab-description" role="tab" aria-controls="panel-description" aria-selected="true" class="tabs__tab">Description</button>
        {specs && <button id="tab-specifications" role="tab" aria-controls="panel-specifications" aria-selected="false" tabindex="-1" class="tabs__tab">Specifications</button>}
        {product.faqs.length > 0 && <button id="tab-faqs" role="tab" aria-controls="panel-faqs" aria-selected="false" tabindex="-1" class="tabs__tab">Faqs</button>}
      </div>

      <section id="panel-description" role="tabpanel" aria-labelledby="tab-description" class="tabs__panel" tabindex="0">
        <h2 class="tabs__heading">Description</h2>
        <div class="prose" set:html={product.description} />
      </section>

      {
        specs && (
          <section id="panel-specifications" role="tabpanel" aria-labelledby="tab-specifications" class="tabs__panel" tabindex="0" hidden>
            <h2 class="tabs__heading">Specifications</h2>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>{specs.headers.map((h) => <th scope="col">{h}</th>)}</tr>
                </thead>
                <tbody>
                  {specs.rows.map((row) => (
                    <tr>
                      {row.map((cell, i) =>
                        i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      {
        product.faqs.length > 0 && (
          <section id="panel-faqs" role="tabpanel" aria-labelledby="tab-faqs" class="tabs__panel" tabindex="0" hidden>
            <h2 class="tabs__heading">Faqs</h2>
            <Faq items={product.faqs} />
          </section>
        )
      }
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="section__title">Related Products</h2>
          <div class="grid grid--4">
            {related.map((p) => (
              <ProductCard href={p.url} name={p.name} image={p.images[0]} headingLevel={3} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaSection />
</Base>

<style>
  .product {
    display: grid;
    grid-template-columns: 400px minmax(0, 1fr) 360px;
    gap: 40px;
    padding-block: 40px;
    align-items: start;
  }
  .product__hero {
    width: 100%; height: auto; display: block; aspect-ratio: 1/1;
    border: 1px solid var(--card-line); border-radius: 4px; object-fit: cover;
    background: var(--white);
  }
  .product__thumbs {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;
    margin: 10px 0 0; padding: 0; list-style: none;
  }
  .product__thumbs li { margin: 0; }
  .thumb-btn {
    display: block; width: 100%; padding: 0; margin: 0;
    background: var(--white); cursor: pointer; overflow: hidden;
    border: 1px solid var(--card-line); border-radius: 3px;
  }
  .thumb-btn img {
    width: 100%; height: auto; display: block; object-fit: cover; aspect-ratio: 1/1;
  }
  .thumb-btn:hover { border-color: var(--peach-text); }
  .thumb-btn.active {
    border-color: var(--peach-text);
    outline: 2px solid var(--peach-text); outline-offset: -2px;
  }

  .product__summary h1 { font-size: 30px; }
  .product__summary p { font-size: var(--fs-small); }
  .product__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
  }
  .product__price-label { font-size: var(--fs-h3); font-weight: 700; color: var(--ink); }
  .product__price-amount { font-size: var(--fs-h3); font-weight: 800; color: var(--ink); }
  .product__stock { color: var(--peach-text); font-weight: 700; }
  .product__actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 22px 0; }

  .product__meta { margin: 0; font-size: var(--fs-small); }
  .product__meta > div { display: flex; gap: 8px; margin-bottom: 4px; }
  .product__meta dt { font-weight: 700; color: var(--ink); }
  .product__meta dd { margin: 0; }
  .product__meta a { color: var(--peach-text); }

  .product__aside { position: sticky; top: 20px; }

  @media (max-width: 1100px) {
    .product { grid-template-columns: 340px minmax(0, 1fr); }
    .product__aside { grid-column: 1 / -1; position: static; max-width: 480px; }
  }
  @media (max-width: 760px) {
    .product { grid-template-columns: minmax(0, 1fr); gap: 26px; padding-block: 26px; }
    .product__aside { max-width: none; }
  }

  .tabs { margin-bottom: 30px; }
  .tabs__list {
    display: flex; flex-wrap: wrap; gap: 2px;
    border-bottom: 1px solid var(--line);
  }
  .tabs__tab {
    padding: 11px 18px;
    font: inherit; font-size: var(--fs-small); font-weight: 600;
    color: var(--body);
    background: var(--card-bg);
    border: 1px solid var(--line); border-bottom: 0;
    border-radius: 4px 4px 0 0;
    cursor: pointer;
  }
  .tabs__tab[aria-selected='true'] { background: var(--white); color: var(--ink); position: relative; top: 1px; }
  .tabs__panel { padding-top: 28px; }
  .tabs__panel:focus-visible { outline-offset: -3px; }
  .tabs__heading { font-size: var(--fs-h2); }
  /* With tabs live the panel heading only repeats the tab label, so it is
     hidden visually but kept for screen readers and for the no-JS layout
     below, where every panel is shown at once and the headings separate them. */
  .tabs[data-enhanced] .tabs__heading {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .tabs[data-enhanced] .tabs__panel { padding-top: 24px; }

  /* Without JS every panel stays visible, so no content is ever unreachable. */
  .tabs:not([data-enhanced]) .tabs__list { display: none; }
  .tabs:not([data-enhanced]) .tabs__panel[hidden] { display: block; }
</style>

<script>
  // Product gallery: clicking a thumbnail swaps the main image in place.
  // Every gallery image is pre-warmed so the swap is instant.
  const mainImg = document.getElementById('main-img') as HTMLImageElement | null;
  const thumbBtns = [...document.querySelectorAll<HTMLButtonElement>('.thumb-btn')];
  if (mainImg && thumbBtns.length > 0) {
    const warmed = new Set<string>();
    const warm = (btn: HTMLButtonElement) => {
      const src = btn.dataset.src;
      if (!src || warmed.has(src)) return;
      warmed.add(src);
      const img = new Image();
      img.fetchPriority = 'low';
      img.decoding = 'async';
      if (btn.dataset.srcset) {
        img.sizes = btn.dataset.sizes || '';
        img.srcset = btn.dataset.srcset;
      }
      img.src = src;
    };

    thumbBtns.forEach((btn) => {
      btn.addEventListener('pointerenter', () => warm(btn));
      btn.addEventListener('touchstart', () => warm(btn), { passive: true });
      btn.addEventListener('click', () => {
        if (!btn.dataset.src) return;
        thumbBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        // srcset first, then src, so the browser never resolves a stale pair.
        if (btn.dataset.sizes) mainImg.sizes = btn.dataset.sizes;
        mainImg.srcset = btn.dataset.srcset || '';
        mainImg.src = btn.dataset.src;
        if (btn.dataset.alt) mainImg.alt = btn.dataset.alt;
      });
    });

    const warmAll = () => thumbBtns.forEach(warm);
    if ('requestIdleCallback' in window) {
      requestIdleCallback(warmAll, { timeout: 3000 });
    } else if (document.readyState === 'complete') {
      setTimeout(warmAll, 500);
    } else {
      window.addEventListener('load', () => setTimeout(warmAll, 500), { once: true });
    }
  }

  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    if (tabs.length < 2) return;
    root.setAttribute('data-enhanced', '');

    const select = (next: HTMLButtonElement, focus = true) => {
      tabs.forEach((tab) => {
        const on = tab === next;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls')!);
        panel?.toggleAttribute('hidden', !on);
      });
      if (focus) next.focus();
    };

    tabs.forEach((tab) => tab.addEventListener('click', () => select(tab, false)));

    root.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
      const evt = e as KeyboardEvent;
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const map: Record<string, number> = {
        ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1,
      };
      if (!(evt.key in map)) return;
      evt.preventDefault();
      select(tabs[(map[evt.key] + tabs.length) % tabs.length]);
    });
  });
</script>

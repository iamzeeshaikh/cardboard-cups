---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import policies from '../data/policies.json';
import { breadcrumbs } from '../lib/schema';

const page = policies['terms-conditions'];
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Terms Conditions' }];
---
<Base
  title="Terms Conditions - Cardboard Cups"
  description="The terms and conditions covering website use, quotations, custom orders, shipping, returns and liability when ordering from Cardboard Cups."
  path="/terms-conditions/"
  ogType="article"
  schema={[breadcrumbs(crumbs)]}
>
  <Breadcrumbs items={crumbs} />
  <article class="section">
    <div class="container narrow">
      <h1>{page.h1}</h1>
      <div class="prose" set:html={page.body} />
    </div>
  </article>
</Base>

<style>
  .narrow { max-width: 860px; }
</style>

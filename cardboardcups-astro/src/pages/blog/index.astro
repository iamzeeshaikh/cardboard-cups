---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SmartImage from '../../components/SmartImage.astro';
import CtaSection from '../../components/CtaSection.astro';
import { breadcrumbs, collectionPage } from '../../lib/schema';
import { BLOG_POSTS } from '../../lib/blog';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Blog' }];

const fmt = (iso: string) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---
<Base
  title="Blog - Cardboard Cups"
  description="Guides on cardboard cup sizes, sleeves, lids, printing and wholesale ordering, written for cafes, food brands and distributors."
  path="/blog/"
  ogType="website"
  schema={[
    breadcrumbs(crumbs),
    collectionPage({
      name: 'Cardboard Cups Blog',
      url: '/blog/',
      description: 'Guides on cardboard cup sizes, sleeves, lids, printing and wholesale ordering.',
      items: BLOG_POSTS.map((p) => ({ name: p.title, url: p.url })),
    }),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="section">
    <div class="container">
      <h1>Cardboard Cups Blog</h1>
      <p class="blog-intro">
        Practical guides on cup sizing, sleeves, lids, printing and wholesale ordering for food service buyers.
      </p>
      <div class="blog-grid">
        {
          BLOG_POSTS.map((post, i) => (
            <article class="blog-card">
              <a href={post.url} class="blog-card__media">
                <SmartImage
                  src={post.image}
                  alt={post.imageAlt}
                  sizes="(max-width: 700px) 92vw, 380px"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              </a>
              <div class="blog-card__body">
                <p class="blog-card__date">{fmt(post.date)}</p>
                <h2 class="blog-card__title">
                  <a href={post.url}>{post.title}</a>
                </h2>
                <p class="blog-card__excerpt">{post.metaDescription}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection />
</Base>

<style>
  .blog-intro {
    max-width: 640px;
    margin-bottom: 2rem;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.75rem;
  }
  .blog-card {
    background: #fff;
    border: 1px solid #eee2d7;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .blog-card__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .blog-card__body {
    padding: 1.1rem 1.25rem 1.4rem;
  }
  .blog-card__date {
    font-size: 0.82rem;
    color: #8a7563;
    margin: 0 0 0.4rem;
  }
  .blog-card__title {
    font-size: 1.12rem;
    line-height: 1.35;
    margin: 0 0 0.5rem;
  }
  .blog-card__title a {
    color: inherit;
    text-decoration: none;
  }
  .blog-card__title a:hover {
    text-decoration: underline;
  }
  .blog-card__excerpt {
    font-size: 0.92rem;
    margin: 0;
    color: #5c4f44;
  }
</style>

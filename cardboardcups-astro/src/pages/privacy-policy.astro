---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import policies from '../data/policies.json';
import { breadcrumbs, webPage } from '../lib/schema';

const page = policies['privacy-policy'];
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Privacy Policy' }];
---
<Base
  title="Privacy Policy - Cardboard Cups"
  description="How Cardboard Cups collects, uses, protects and shares information when you visit our website or contact us for a quote."
  path="/privacy-policy/"
  ogType="article"
  schema={[breadcrumbs(crumbs), webPage({ path: '/privacy-policy/', name: 'Privacy Policy - Cardboard Cups', description: 'How Cardboard Cups collects, uses, protects and shares information when you visit our website or contact us for a quote.' })]}
>
  <Breadcrumbs items={crumbs} />
  <article class="section">
    <div class="container narrow">
      <h1>{page.h1}</h1>
      <div class="prose" set:html={page.body} />
    </div>
  </article>
</Base>

<style>
  .narrow { max-width: 860px; }
</style>

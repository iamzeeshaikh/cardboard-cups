---
/** Keyboard-accessible FAQ accordion built on <details>, so it works without JS. */
interface Props { items: { question: string; answer: string }[]; headingLevel?: 2 | 3; }
const { items, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
---
<div class="faq">
  {items.map((item) => (
    <details class="faq__item">
      <summary>
        <H class="faq__q">{item.question}</H>
        <span class="faq__mark" aria-hidden="true"></span>
      </summary>
      <div class="faq__a prose" set:html={item.answer} />
    </details>
  ))}
</div>

<style>
  .faq__item {
    margin-bottom: 10px;
    background: #f7f7f7;
    border: 1px solid var(--card-line);
    border-radius: 4px;
  }
  .faq__item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 14px 18px; cursor: pointer; list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__q { margin: 0; font-size: var(--fs-body); font-weight: 600; color: var(--ink); }
  .faq__mark { position: relative; flex: none; width: 14px; height: 14px; }
  .faq__mark::before, .faq__mark::after {
    content: ''; position: absolute; inset: 0; margin: auto;
    background: var(--ink); transition: transform .2s ease, opacity .2s ease;
  }
  .faq__mark::before { width: 14px; height: 2px; }
  .faq__mark::after { width: 2px; height: 14px; }
  .faq__item[open] .faq__mark::after { transform: rotate(90deg); opacity: 0; }
  .faq__a { padding: 0 18px 16px; }
  .faq__a :global(p) { margin: 0 0 .8em; font-size: var(--fs-small); }
  .faq__a :global(p:last-child) { margin-bottom: 0; }
</style>

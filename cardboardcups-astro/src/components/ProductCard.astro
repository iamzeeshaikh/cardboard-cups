---
import SmartImage from './SmartImage.astro';
interface Props {
  href: string; name: string; image?: { src: string; alt: string } | null;
  headingLevel?: 2 | 3; loading?: 'lazy' | 'eager';
}
const { href, name, image, headingLevel = 2, loading = 'lazy' } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
---
<article class="card">
  <a class="card__link" href={href}>
    <span class="card__media">
      {image
        ? <SmartImage src={image.src} alt={image.alt} sizes="(max-width:640px) 90vw, (max-width:1024px) 45vw, 260px" ratio="1/1" loading={loading} />
        : <span class="card__placeholder" aria-hidden="true"></span>}
    </span>
    <H class="card__title">{name}</H>
  </a>
</article>

<style>
  .card { background: var(--card-bg); border: 1px solid var(--card-line); border-radius: 4px; height: 100%; }
  .card__link { display: flex; flex-direction: column; height: 100%; padding: 14px 14px 6px; text-decoration: none; color: inherit; }
  .card__media { display: block; background: var(--white); border-radius: 3px; overflow: hidden; }
  .card__media :global(img) { width: 100%; height: auto; aspect-ratio: 1/1; object-fit: cover; display: block; transition: transform .3s ease; }
  .card__link:hover .card__media :global(img) { transform: scale(1.04); }
  .card__placeholder { display: block; aspect-ratio: 1/1; background: var(--card-bg); }
  .card__title {
    margin: 16px 0 12px; font-size: var(--fs-small); font-weight: 400;
    color: var(--body); text-align: center; line-height: 1.45;
  }
  .card__link:hover .card__title { color: var(--peach-text); }
  @media (prefers-reduced-motion: reduce) { .card__media :global(img) { transition: none; } }
</style>

---
import { CTA } from '../data/site';
---
<section class="cta">
  <div class="container">
    <h2>Order Cardboard Cups with Confidence</h2>
    <p>Choose cardboard cups that support your business operations, brand identity, and sustainability goals.</p>
    <div class="cta__actions">
      <a class="btn btn--primary" href={CTA.quote.href}>Get Free Quote</a>
      <a class="btn btn--onDark" href="/contact-us/">Contact Sales</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative; padding-block: 76px; text-align: center; color: var(--white);
    background-color: #2f2b28;
    background-image: linear-gradient(rgb(0 0 0 / 55%), rgb(0 0 0 / 55%)),
      url('/wp-content/uploads/2025/12/double-layer-coffee-cup.jpg');
    background-size: cover; background-position: center;
  }
  .cta h2 { color: var(--white); margin-bottom: 12px; }
  .cta p { max-width: 60ch; margin-inline: auto; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; margin-top: 26px; }
</style>
